<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Activity window theme — no action bar, full-screen dark background.
         Compose controls all UI chrome; this only covers the window itself. -->
    <style name="Theme.MyCompass" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
