<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device.

    The app persists exactly three booleans — true north, daylight mode, and
    AR auto-switch. Each is one tap away on the main screen and each already
    defaults to the right value for almost everyone, so restoring them saves a
    user about three taps once in the lifetime of the install. That is not worth
    declaring on the Play Data Safety form that user data is transferred off the
    device, nor worth keeping a backup allow-list correct as the app grows.

    android:allowBackup="false" covers cloud backup. It does NOT cover
    device-to-device transfer on Android 12+, which is governed here — hence the
    explicit exclusions below rather than an empty file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
