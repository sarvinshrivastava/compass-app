<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Sensor access ────────────────────────────────────────────────────── -->
    <!-- No explicit permission needed for TYPE_ACCELEROMETER / TYPE_MAGNETIC_FIELD;
         they are non-protected sensors available to all apps.               -->

    <!-- ── Location — used only for GeomagneticField declination correction ──
         Coarse is enough: declination varies over tens of kilometres, so a
         city-block fix gives the same correction as a GPS-precise one. Asking
         for FINE would buy nothing and cost the user the stronger prompt.  -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Declare that this app requires a compass (hard requirement) -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="true" />

    <!-- ── Advertising ID: explicitly removed ──────────────────────────────
         firebase-analytics merges com.google.android.gms.permission.AD_ID (and
         the ADSERVICES pair) in transitively. The google_analytics_* meta-data
         flags below stop the SDK *using* the advertising ID, but they do not
         remove the *declaration* — and Play's Data Safety review reads the
         manifest, not the flags. Left in, the store would report this app as
         using an advertising ID it never touches. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- Camera — used for AR overlay (CameraX, no ARCore) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Compass">

        <!-- ── Analytics collection scope ──────────────────────────────────
             Firebase collects the advertising ID and sets ad-personalisation
             signals by default, and logs a screen_view on every screen
             transition. None of that is wanted here: the seven events exist to
             decide what to delete, not to build an audience, and switching them
             off keeps the Play Data Safety answers at "not linked to identity".

             Screen reporting is off deliberately. The privacy policy states
             that the app logs no screen views, and without this flag that
             sentence is false — Firebase's default is on. Note that the
             standard lifecycle events (first_open, session_start,
             user_engagement, app_update, app_remove, app_exception) cannot be
             disabled and are still sent; they fall under the App interactions
             type this app already declares.
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- ── Main activity ──────────────────────────────────────────────── -->
        <!--
            singleTop: the widget starts this activity with FLAG_ACTIVITY_NEW_TASK,
            and under the default "standard" mode that pushed a SECOND MainActivity
            on top of the running one — a second ViewModel and a second sensor
            registration per tap, with duplicate back-stack entries the user had
            to press through. singleTop resumes the existing instance instead.
        -->
        <!--
            Orientation is decided per page, not here — see `ui/Page.kt`.

            The compass pins portrait: its rose is a circle capped on width
            under a 52 sp readout, so landscape only takes away the dimension
            the layout is built around. The level does not pin, because it
            measures how the device is held — freezing the UI while the user
            rotates it reads as the screen having stopped responding.

            `configChanges` is what makes that switch cheap. Without it,
            setRequestedOrientation recreates the Activity: a blank frame, the
            camera unbinding and paying its ~500 ms first-frame cost again, and
            every rememberSaveable round-tripping through save/restore.

            Note this only binds phones. Verified on API 36: a display wider
            than ~600 dp ignores the request entirely and renders landscape
            regardless, so large screens still need a real layout.
                -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Glance app widget receiver ────────────────────────────────── -->
        <!--
            exported="true" is required so the launcher and system can send
            APPWIDGET_UPDATE broadcasts to discover the widget. That is the
            only action it answers — the tile shows no live data, so there is
            nothing for a custom refresh broadcast to do.
        -->
        <receiver
            android:name=".widget.CompassWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compass_appwidget_info" />
        </receiver>

    </application>

</manifest>
