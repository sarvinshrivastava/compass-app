<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Sensor access ────────────────────────────────────────────────────── -->
    <!-- No explicit permission needed for TYPE_ACCELEROMETER / TYPE_MAGNETIC_FIELD;
         they are non-protected sensors available to all apps.               -->

    <!-- ── Location — used only for GeomagneticField declination correction ──
         Coarse is enough: declination varies over tens of kilometres, so a
         city-block fix gives the same correction as a GPS-precise one. Asking
         for FINE would buy nothing and cost the user the stronger prompt.  -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Declare that this app requires a compass (hard requirement) -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="true" />

    <!-- ── Advertising ID: explicitly removed ──────────────────────────────
         firebase-analytics merges com.google.android.gms.permission.AD_ID (and
         the ADSERVICES pair) in transitively. The google_analytics_* meta-data
         flags below stop the SDK *using* the advertising ID, but they do not
         remove the *declaration* — and Play's Data Safety review reads the
         manifest, not the flags. Left in, the store would report this app as
         using an advertising ID it never touches. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <!-- Camera — used for AR overlay (CameraX, no ARCore) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Compass">

        <!-- ── Analytics collection scope ──────────────────────────────────
             Firebase collects the advertising ID and sets ad-personalisation
             signals by default. Neither is wanted here: the six events exist to
             decide what to delete, not to build an audience, and switching both
             off keeps the Play Data Safety answers at "not linked to identity".
        -->
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />

        <!-- ── Main activity ──────────────────────────────────────────────── -->
        <!--
            singleTop: the widget starts this activity with FLAG_ACTIVITY_NEW_TASK,
            and under the default "standard" mode that pushed a SECOND MainActivity
            on top of the running one — a second ViewModel and a second sensor
            registration per tap, with duplicate back-stack entries the user had
            to press through. singleTop resumes the existing instance instead.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Glance app widget receiver ────────────────────────────────── -->
        <!--
            exported="true" is required so the launcher and system can send
            APPWIDGET_UPDATE broadcasts to discover the widget. That is the
            only action it answers — the tile shows no live data, so there is
            nothing for a custom refresh broadcast to do.
        -->
        <receiver
            android:name=".widget.CompassWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/compass_appwidget_info" />
        </receiver>

    </application>

</manifest>
