# Keystore files — never commit a signing key, even to a private repo.
*.jks
*.keystore

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. Maps API key, Firebase)
# Firebase config. Google documents this as non-secret (its key is restricted
# by package name + signing cert), but the repo's visibility is not verifiable
# from here and a key committed to history cannot be un-committed. Keep it
# local. Setup instructions for obtaining it live in README.md.
app/google-services.json

# Freeline
bin/
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# Android Profiling
*.hprof

# Kotlin
.kotlin/

# Generated store assets. A leading "./" is not a valid gitignore pattern and
# silently matches nothing, which is what the previous line here did.
#
# The OUTPUTS are ignored because they are reproducible: run the scripts in
# docs/launch/assets/tools/ and every one of them comes back byte-identical.
# The INPUTS stay tracked — the raw device captures cannot be regenerated from
# anything, and without them the generators have nothing to read.
docs/launch/assets/*.png
docs/launch/assets/screenshots/
# ...and this one, which ar_composite.py rebuilds from raw-02-ar.png + forest-pov.png
docs/launch/assets/screenshots-raw/raw-02-ar-forest.png

# Python bytecode from the asset generators
__pycache__/
*.pyc

# MCP scratch output and one-off visual checks — never part of the build.
.playwright-mcp/
iconcheck.png

# ── BMAD v6 ──────────────────────────────────────────────────────────────
# Regenerate with:
#   npx bmad-method@6.12.0 install --directory . --modules bmm \
#     --tools claude-code --no-shims --yes
# The installed framework and its generated Claude skills are reinstallable and
# never worth a diff. `_bmad-output/` IS tracked: it holds the architecture
# spine and its decision memlog, which are authored, not generated.
_bmad/
.claude/skills/
